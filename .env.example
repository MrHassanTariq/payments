# Database
DATABASE_URL=postgresql://user:password@localhost:5432/payments

# Payment Provider Configuration
# Set which provider to use: 'stripe' | 'paypal' | 'airwallex'
PAYMENT_PROVIDER=stripe

# Stripe Configuration (if using Stripe)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal Configuration (if using PayPal)
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# Airwallex Configuration (if using Airwallex)
AIRWALLEX_API_KEY=xxx
AIRWALLEX_CLIENT_ID=xxx
